# ─────────────────────────────────────────────────────────────
# AxLink Settlement Service — Environment Variables
# Copy this file to .env and fill in all values
# cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=4000

# Public URL of this service (used for webhook callbacks)
# Local:      http://localhost:4000/api
# Production: https://api-finance.axstron.com/api
API_BASE_URL=http://localhost:4000/api

# ── Database (PostgreSQL) ──────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/axlink_settlement

# ── B2BinPay LP (Liquidity Provider) ─────────────────────────
# Dashboard: https://sandbox.b2binpay.com (sandbox) | https://b2binpay.com (prod)
# Profile → Access list → API tab → Regenerate

B2BINPAY_CLIENT_ID=your_client_id          # max 18 characters
B2BINPAY_CLIENT_SECRET=your_client_secret
B2BINPAY_CALLBACK_SECRET=your_callback_secret   # required in production (F2): callbacks are refused (503) until set

# The B2BinPay wallet ID used for on-ramp / off-ramp
# Found in: B2BinPay Dashboard → Wallets
B2BINPAY_WALLET_ID=your_wallet_id

# true = sandbox.b2binpay.com | false = production
B2BINPAY_SANDBOX=true

# ── Fireblocks (Custody + Vaults) ────────────────────────────
# Dashboard: https://sandbox.fireblocks.io (sandbox) | console.fireblocks.io (prod)
# Settings → Users & API Keys → Add API User → upload fireblocks.csr

# API Key shown after uploading CSR in Fireblocks Console
FIREBLOCKS_API_KEY=your_fireblocks_api_key

# Path to your RSA-4096 private key (generated locally, NEVER commit this file)
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out fireblocks_secret.key
#           openssl req -new -key fireblocks_secret.key -out fireblocks.csr
#           Upload fireblocks.csr to Fireblocks Console
FIREBLOCKS_SECRET_KEY_PATH=./fireblocks_secret.key

# true = sandbox-api.fireblocks.io | false = api.fireblocks.io
FIREBLOCKS_SANDBOX=true

# USDT asset on Solana (gasless, fast settlement)
FIREBLOCKS_USDT_ASSET=USDT_SOL

# AxLink treasury vault ID (used for off-ramp withdrawals)
# Create in Fireblocks: Vaults → Add Vault Account → name it "AxLink Treasury"
FIREBLOCKS_TREASURY_VAULT=your_treasury_vault_id

# On-chain settlement address for external withdrawals (Fireblocks USDT_SOL address)
FIREBLOCKS_SETTLEMENT_ADDRESS=your_settlement_address

# Fireblocks public key for webhook signature verification
# Fireblocks Console → Webhooks → Public Key (paste full PEM here)
FIREBLOCKS_WEBHOOK_PUBLIC_KEY=   # legacy pinned PEM; configure this OR official regional JWKS below

# ── Brainrock (Fiat Banking Layer) ───────────────────────────────────────────
# Provides virtual IBANs per user + outbound fiat payments (bank/M-Pesa/SEPA)
# Dashboard: https://dashboard.brainrock.io (or sandbox.brainrock.io)
# Compatible with: Square, Railsr, ClearBank, Banking Circle (same pattern)

# API key from Brainrock dashboard
BRAINROCK_API_KEY=your_brainrock_api_key

# Webhook secret for validating inbound payment events
BRAINROCK_WEBHOOK_SECRET=your_brainrock_webhook_secret

# true = sandbox | false = production
BRAINROCK_SANDBOX=true

# AxLink master treasury account at Brainrock
# Used for: sending fiat payouts to users after B2BinPay off-ramp
# Create in Brainrock: Accounts → Create Account → name "AxLink Treasury"
BRAINROCK_TREASURY_ACCOUNT_ID=your_brainrock_treasury_account_id

# ─────────────────────────────────────────────────────────────
# Settlement engine
# ─────────────────────────────────────────────────────────────

# ── Solana (settlement verification) ──────────────────────────
# A transfer is not settled because Fireblocks accepted it; it is settled when
# a Solana node reports the signature FINALIZED. This is the node we ask.
#
# Leave unset and it falls back to the public mainnet endpoint, which is
# rate-limited and unsuitable for production: when verification cannot reach a
# node, the engine correctly refuses to complete transfers, so the symptom of
# using the public endpoint is settlements piling up unproven.
# Use Helius, Triton, QuickNode, or your own validator.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_TIMEOUT_MS=10000

# ── Settlement resume worker ──────────────────────────────────
# Drives stalled settlement legs forward after a crash or a partner outage.
# Without it, a settlement that stops between the customer debit and the
# partner payout stays stopped until someone notices.
SETTLEMENT_WORKER_ENABLED=true
SETTLEMENT_WORKER_INTERVAL_MS=15000
SETTLEMENT_WORKER_BATCH=25

# ── Outbox worker (member-bank webhooks) ──────────────────────
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=10000
OUTBOX_WORKER_BATCH=25
OUTBOX_DELIVERY_TIMEOUT_MS=10000

# ── Reconciliation ────────────────────────────────────────────
# Relative tolerance when comparing ledger vs custody vs on-chain positions.
# 0.0001 = 1bp. The absolute delta is recorded either way.
RECON_TOLERANCE=0.0001

# Addresses to check on chain, as label=address pairs. The label must match the
# vault id used in the CUSTODY:<vaultId>:<ASSET> account code.
# e.g. RECON_ONCHAIN_ADDRESSES=treasury=7xKX...gAsU,hot=9WzD...Xh1t
RECON_ONCHAIN_ADDRESSES=
RECON_ONCHAIN_ASSET=USDT

# ── Ops API ───────────────────────────────────────────────────
# Gates every /api/settlement/* route except the public proof endpoint.
# Generate with: openssl rand -hex 32
OPS_API_KEY=

# ── Production only: Fireblocks key as base64 ─────────────────
# DigitalOcean App Platform has no file mounts, so the RSA key is passed
# base64-encoded and written to disk at boot by scripts/write-fireblocks-key.sh.
# Prepare with: base64 -i fireblocks_secret.key | pbcopy
# FIREBLOCKS_SECRET_KEY_B64=

# ── Settlement harness ────────────────────────────────────────
# Runs real settlements through the engine against stubbed rails.
# NEVER set true in an environment holding customer funds: it allows the
# converter, custodian and Solana RPC to be replaced in-process. Refused
# outright when NODE_ENV=production.
#   npm run simulate            all scenarios
#   npm run simulate -- --list  what they prove
SIMULATOR_ENABLED=false

# Safety catch: the harness refuses a database containing non-simulated users.
# Only set true if you are certain — it deletes exactly its own rows, never truncates.
SIMULATOR_ALLOW_POPULATED_DB=false

# ── Payout partner float accounts ─────────────────────────────────────────────
# The account at each payout partner that B2BinPay wires settlement funds to.
# jitFundProvider throws without these — a withdrawal cannot be funded if there
# is nowhere to send the money.
DARAJA_B2C_FLOAT_ACCOUNT=
CHOICEBANK_FLOAT_ACCOUNT=
# BRAINROCK_TREASURY_ACCOUNT_ID is set above and serves the same role.

# ── Internal ops ──────────────────────────────────────────────────────────────
# Required by /api/ops/* and /api/settlement/*. Without it those endpoints
# fail closed. Never expose to banks or customers.
OPS_API_KEY=

# ── Local demo only ───────────────────────────────────────────────────────────
# Mounts /api/demo, which issues KYC-approved accounts. Never set in production.
DEMO_ENABLED=false

# ── Daraja / M-Pesa (Safaricom) — KES, TZS, UGX mobile money ──────────────────
# Portal: https://developer.safaricom.co.ke → create an app → B2C product.
# Required for every mobile-money payout. Without them sendB2C returns a
# sandbox stub locally and throws in production.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_INITIATOR_NAME=
# Encrypt the initiator password with Safaricom's public certificate; the
# result is this value, not the password itself.
DARAJA_SECURITY_CREDENTIAL=
# STK Push (customer-initiated deposits) only.
DARAJA_PASSKEY=
DARAJA_SANDBOX=true

# ── Choice Bank — NGN, GHS, ZAR, KES, RWF, XOF, XAF, CNY bank transfers ───────
CHOICE_BANK_API_KEY=
CHOICE_BANK_WEBHOOK_SECRET=
CHOICE_BANK_SANDBOX=true
CHOICEBANK_TREASURY_ACCOUNT=

# ── Cards (Brainrock) ─────────────────────────────────────────────────────────
# Only needed if issuing cards. Card authorisation is a live path — Visa/MC
# expect a decision in under 100ms.
BRAINROCK_CARD_PROGRAM_ID=

# ── Settlement engine ─────────────────────────────────────────────────────────
# The asset used as the internal value carrier. USDT unless deliberately changed.
SETTLEMENT_ASSET=USDT
# Public URL of the customer-facing app, used in payment session redirects.
APP_URL=
# Direct (non-pooled) Postgres URL. Prisma migrations need this when the main
# DATABASE_URL points at a connection pooler such as PgBouncer.
# Leave empty unless you use a pooled DATABASE_URL and need a direct connection for migrations.
DIRECT_DATABASE_URL=
# Real Kafka when set; an in-process event bus when not. Safe to leave empty.
KAFKA_BROKERS=

# ── Float accounts: the same account, two names ───────────────────────────────
# CAUTION. Payouts and the treasury rebalancer read the partner float account
# under DIFFERENT variable names, so setting only one pair leaves the other
# module pointing at an empty string:
#
#   payouts (baas-registry)      DARAJA_B2C_FLOAT_ACCOUNT   CHOICEBANK_FLOAT_ACCOUNT
#   rebalancer (treasury)        DARAJA_FLOAT_ACCOUNT       CHOICEBANK_TREASURY_ACCOUNT
#
# Until they are unified, set both names of each pair to the same value.
DARAJA_FLOAT_ACCOUNT=

# ── Coming-soon providers ─────────────────────────────────────────────────────
# Written and registered by one commented line in bootstrap/baas.bootstrap.ts.
# Leave empty unless enabling them.
MTNMOMO_PRIMARY_KEY=
MTNMOMO_API_USER=
MTNMOMO_API_KEY=
MTNMOMO_API_URL=
MTNMOMO_ENV=
MTN_FLOAT_ACCOUNT=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_FLOAT_ACCOUNT=
THUNES_CLIENT_ID=
THUNES_API_KEY=
THUNES_API_URL=

# ── Step 1 platform ───────────────────────────────────────────────────────────
# Validated at boot (src/platform/config.ts). In production OPS_API_KEY is required and
# SIMULATOR_ENABLED / DEMO_ENABLED must be false.
LOG_LEVEL=info
# Optional server-side pepper mixed into institution API-key hashes. Rotating it invalidates every key.
API_KEY_PEPPER=

# Legacy compatibility flag: no longer permits unsigned callbacks in any environment.
# Keep false; sandbox tests use generated signing keys. Production refuses true.
ALLOW_UNVERIFIED_WEBHOOKS=false

# Fireblocks RS512 detached-JWS verification (select the official workspace region).
# Optional alternative to the legacy pinned FIREBLOCKS_WEBHOOK_PUBLIC_KEY.
# FIREBLOCKS_WEBHOOK_JWKS_URL=https://sandbox-keys.fireblocks.io/.well-known/jwks.json
# Unsigned callbacks are always refused, including in development.

# Required trust boundary: signed workspaceId (V2) / tenantId (V1) must match.
FIREBLOCKS_WORKSPACE_ID=
WEBHOOK_ENCRYPTION_KEY=   # 32 bytes, hex or base64 — encrypts institution webhook secrets; required in production
WEBHOOK_ALLOW_INSECURE_URLS=false   # tests only: http and private hosts for institution webhooks; refused in production

# ── Outbound settlement policy (Step 2) ────────────────────────────────────────
# Production outbound is refused until this is set deliberately after the go-live checklist (docs/GO-LIVE.md).
OUTBOUND_SETTLEMENT_ENABLED=false
# Deployment defaults; operations override per institution environment.
TRANSFER_MAX_AMOUNT=1000000
TRANSFER_DAILY_LIMIT=5000000
TRANSFER_MAX_PER_HOUR=200
TRANSFER_AUTO_APPROVE_LIMIT_SANDBOX=100000
MAX_WALLETS_PER_ENVIRONMENT=20
# Sanctions screening of external addresses. Leave SCREENING_OPTIONAL unset in production.
# Sandbox stub only: SCREENING_DENYLIST=<address>:BLOCKED,<address>:REVIEW
#SCREENING_OPTIONAL=false
