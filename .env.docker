# ── Docker environment — fill in your real credentials ────────────────────────
# DATABASE_URL and REDIS_URL are injected by docker-compose, do not set here

PORT=4000
API_BASE_URL=http://localhost:4000/api

# B2BinPay
B2BINPAY_CLIENT_ID=your_client_id_here
B2BINPAY_CLIENT_SECRET=your_client_secret_here
B2BINPAY_CALLBACK_SECRET=your_callback_secret_here
B2BINPAY_WALLET_ID=your_b2binpay_wallet_id
B2BINPAY_SANDBOX=true

# Fireblocks
FIREBLOCKS_API_KEY=your_fireblocks_api_key_here
FIREBLOCKS_SECRET_KEY_PATH=/app/fireblocks_secret.key
FIREBLOCKS_SANDBOX=true
FIREBLOCKS_WEBHOOK_PUBLIC_KEY=
FIREBLOCKS_USDT_ASSET=USDT_SOL
FIREBLOCKS_TREASURY_VAULT=your_treasury_vault_id
FIREBLOCKS_SETTLEMENT_ADDRESS=your_settlement_address

# Brainrock — GBP, USD, EUR, CAD, AED corridors
BRAINROCK_API_KEY=your_brainrock_api_key
BRAINROCK_WEBHOOK_SECRET=your_brainrock_webhook_secret
BRAINROCK_SANDBOX=true
BRAINROCK_TREASURY_ACCOUNT_ID=your_treasury_account_id

# Choice Bank Nigeria — African bank transfers (NGN, GHS, ZAR)
CHOICE_BANK_API_KEY=your_choice_bank_api_key
CHOICE_BANK_WEBHOOK_SECRET=your_choice_bank_webhook_secret
CHOICE_BANK_SANDBOX=true

# Daraja API — M-Pesa direct (KES, TZS, UGX)
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_SHORTCODE=your_shortcode
DARAJA_PASSKEY=your_passkey
DARAJA_INITIATOR_NAME=APPRA
DARAJA_SECURITY_CREDENTIAL=your_security_credential
DARAJA_SANDBOX=true
