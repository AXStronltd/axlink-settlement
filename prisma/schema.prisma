generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── User & accounts ──────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  kycStatus       String   @default("PENDING")

  // Brainrock — virtual IBAN per user (fiat deposits: GBP/USD/EUR/CAD/AED)
  brainrockAccountId String?         // Brainrock virtual account ID
  virtualIban        String?         // Virtual IBAN shown to user for bank transfers
  virtualIbanBic     String?         // BIC for the virtual IBAN

  // Choice Bank Nigeria — virtual account per user (fiat deposits: NGN/GHS/ZAR)
  choiceBankAccountId String?        // Choice Bank virtual account ID
  choiceBankAccountNumber String?    // Account number shown to user for bank transfers

  // Fireblocks — one vault per user, USDT address per asset
  vaultId         String   @unique   // Fireblocks vault ID (e.g. "vault_james_001")
  usdtAddress     String?            // Fireblocks USDT_SOL deposit address for this vault

  // B2BinPay — one wallet per user for receiving fiat on-ramp
  b2bWalletId     String?            // B2BinPay wallet ID paired to this user

  // Remediation F4: owning institution (tenant). Null = legacy row created before tenancy;
  // only an ops credential can reach those.
  institutionId   String?
  institution     Institution? @relation(fields: [institutionId], references: [id])
  wallet          Wallet?      // Step 2: the Wallet backfilled from this user's vault

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts          Account[]
  sentTransfers     Transfer[]          @relation("sender")
  receivedTransfers Transfer[]          @relation("receiver")
  withdrawals       Withdrawal[]
  bankDeposits      BankDeposit[]
  cryptoBuys        CryptoBuy[]
  cards             Card[]
}

// One account per currency per user (KES, GBP, USD, NGN, etc.)
model Account {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  currency    String   // ISO code: KES, GBP, USD, NGN, GHS, ZAR, EUR
  balance     Decimal  @default(0) @db.Decimal(20, 8) // local currency
  balanceUsd  Decimal  @default(0) @db.Decimal(20, 8) // USD base value
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, currency])
}

// ── Transfers (internal — user to user) ──────────────────────────────────────

model Transfer {
  id           String   @id @default(cuid())
  trackingId   String   @unique
  senderId     String
  sender       User     @relation("sender", fields: [senderId], references: [id])
  receiverId   String
  receiver     User     @relation("receiver", fields: [receiverId], references: [id])
  fromCurrency String
  toCurrency   String
  fromAmount   Decimal  @db.Decimal(20, 8) // what sender pays
  toAmount     Decimal  @db.Decimal(20, 8) // what receiver gets
  usdAmount    Decimal  @db.Decimal(20, 8) // internal USD base
  usdtAmount   Decimal  @db.Decimal(20, 8) // USDT moved via Fireblocks
  fxRate       Decimal? @db.Decimal(20, 8) // rate applied if cross-currency
  note         String?
  status       String   @default("PENDING")
  // PENDING | PROCESSING | COMPLETED | FAILED

  // B2BinPay references (0, 1, or 2 depending on flow)
  onrampId     String?  // B2BinPay deposit ID
  offrampId    String?  // B2BinPay payout ID

  // Fireblocks reference
  fbTxId       String?
  fbTxHash     String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Withdrawals (AxLink → external bank) ────────────────────────────────────

model Withdrawal {
  id          String   @id @default(cuid())
  trackingId  String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  currency    String
  amount      Decimal  @db.Decimal(20, 8)
  usdAmount   Decimal  @db.Decimal(20, 8)
  usdtAmount  Decimal  @db.Decimal(20, 8)
  bankAccount String   // destination bank/mobile account
  bankName    String
  note        String?
  status      String   @default("PENDING")

  offrampId          String?  // B2BinPay payout ID
  fbTxId             String?  // Fireblocks debit TX
  brainrockPaymentId String?  // Brainrock outbound payment ID (fiat delivery)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Bank deposits (external bank → AxLink) ──────────────────────────────────

model BankDeposit {
  id          String   @id @default(cuid())
  trackingId  String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  currency    String
  amount      Decimal  @db.Decimal(20, 8)
  usdAmount   Decimal  @db.Decimal(20, 8)
  usdtAmount  Decimal  @db.Decimal(20, 8)
  bankName    String
  reference   String?  // bank reference number / Brainrock sessionId
  method      String?  // apple_pay | google_pay | open_banking | bank_transfer | mobile_money
  status      String   @default("PENDING")

  onrampId    String?  // B2BinPay deposit ID
  fbTxId      String?  // Fireblocks credit TX
  sessionId   String?  @unique  // Brainrock payment session ID (user-initiated flow)
  checkoutUrl String?           // Brainrock checkout URL returned to frontend

  // Remediation F3: the registry asset (network + contract) that actually arrived in custody.
  settlementAssetId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Crypto buy (user deliberately buys USDT) ─────────────────────────────────

model CryptoBuy {
  id          String   @id @default(cuid())
  trackingId  String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  fromCurrency String
  fromAmount  Decimal  @db.Decimal(20, 8)
  usdtAmount  Decimal  @db.Decimal(20, 8)
  usdAmount   Decimal  @db.Decimal(20, 8)
  status      String   @default("PENDING")
  fbTxId      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Exchange rate cache ───────────────────────────────────────────────────────

model ExchangeRate {
  id        String   @id @default(cuid())
  fromCurr  String
  toCurr    String
  rate      Decimal  @db.Decimal(20, 8)
  source    String   @default("b2binpay")
  expiresAt DateTime

  @@unique([fromCurr, toCurr])
}

// ── Cards ─────────────────────────────────────────────────────────────────────
// Issued by Brainrock (or any card provider). One card per user initially.
// Debit on authorization, credit on reversal — no separate hold mechanism.

model Card {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  providerCardId  String   @unique   // Brainrock / issuer card ID
  last4           String             // last 4 digits shown in app
  brand           String             // "visa" | "mastercard"
  cardType        String   @default("virtual")  // "virtual" | "physical"
  currency        String             // primary spending currency (debit currency)
  status          String   @default("ACTIVE")   // ACTIVE | FROZEN | CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authorizations  CardAuthorization[]
}

// Each Visa/MC authorization attempt — tracks status through the lifecycle
model CardAuthorization {
  id               String   @id @default(cuid())
  cardId           String
  card             Card     @relation(fields: [cardId], references: [id])
  userId           String
  providerAuthId   String   @unique   // issuer's authorization ID
  amount           Decimal  @db.Decimal(20, 8)  // amount in spendCurrency
  spendCurrency    String              // currency at point of sale
  debitAmount      Decimal  @db.Decimal(20, 8)  // amount debited from user account (in debitCurrency)
  debitCurrency    String              // user's account currency (may differ from spendCurrency)
  fxRate           Decimal? @db.Decimal(20, 8)  // rate used if cross-currency spend
  merchantName     String?
  merchantCategory String?
  status           String   @default("PENDING")
  // PENDING | APPROVED | DECLINED | SETTLED | REVERSED
  declineReason    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── AxLink Network — Bank members ────────────────────────────────────────────
// Each bank that connects to the AxLink network is a tenant here.
// They get their own Fireblocks vault, API key, and per-corridor limits.

model Bank {
  id              String   @id @default(cuid())
  name            String                          // "Equity Bank Kenya"
  networkId       String   @unique                // "AXLK-KE-001" — AxLink BIC equivalent
  apiKeyHash      String   @unique                // SHA-256 of the raw API key (never store plain)
  vaultId         String   @unique                // Fireblocks vault for this bank's treasury USDT
  webhookUrl      String?                         // where AxLink POSTs settlement confirmations
  webhookSecret   String?                         // HMAC secret for signing outbound webhooks
  status          String   @default("ACTIVE")     // ACTIVE | SUSPENDED | PENDING
  dailyLimitUsd   Decimal  @default(1000000) @db.Decimal(20, 2) // max USD settled per day
  corridorLimits  Json?                           // { "GBP:KES": 500000, "USD:NGN": 250000 }
  fbNetworkConnId String?                         // Fireblocks Network connection ID (bilateral channel)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transfers       InterbankTransfer[]
  apiUsage        BankApiUsage[]

  // Step 1: optional link to the owning institution (tenant). Backfilled in Step 2.
  institutionId   String?
  institution     Institution? @relation(fields: [institutionId], references: [id])

  @@index([institutionId])
}

// Rolling 24-hour usage tracker for per-bank daily limits
model BankApiUsage {
  id          String   @id @default(cuid())
  bankId      String
  bank        Bank     @relation(fields: [bankId], references: [id])
  date        String                              // "2026-06-12" (UTC date)
  settledUsd  Decimal  @default(0) @db.Decimal(20, 2)
  txCount     Int      @default(0)

  @@unique([bankId, date])
}

// Bank-to-bank settlement instruction — the SWIFT MT103 equivalent on AxLink
model InterbankTransfer {
  id               String   @id @default(cuid())
  trackingId       String   @unique               // AxLink ref: "ibt_<uuid>"
  bankReferenceId  String                         // bank's own ref (idempotency key)
  senderBankId     String
  senderBank       Bank     @relation(fields: [senderBankId], references: [id])
  senderCurrency   String
  senderAmount     Decimal  @db.Decimal(20, 8)
  receiverBankId   String                         // networkId of receiving bank
  receiverCurrency String
  receiverAmount   Decimal  @db.Decimal(20, 8)
  usdAmount        Decimal  @db.Decimal(20, 8)
  usdtAmount       Decimal  @db.Decimal(20, 8)
  fxRate           Decimal? @db.Decimal(20, 8)
  routeType        String                         // IDENTITY | STABLE | MAJOR | CORRIDOR
  spread           Decimal  @db.Decimal(10, 6)
  lpSource         String?
  fbTxId           String?                        // Fireblocks settlement tx
  solanaTxHash     String?
  // Sender customer (for Travel Rule / compliance)
  senderName       String?
  senderAccount    String?
  // Receiver customer
  receiverName     String?
  receiverAccount  String?
  status           String   @default("PENDING")
  // PENDING | PROCESSING | COMPLETED | FAILED | REVERSED
  webhookDelivered Boolean  @default(false)
  webhookAttempts  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([senderBankId, bankReferenceId])
  @@index([senderBankId, createdAt])
  @@index([status])
}

// ── Settlement audit log ──────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  entityType String   // Transfer | Withdrawal | BankDeposit | CryptoBuy
  entityId   String
  event      String   // CREATED | STATUS_CHANGED | ERROR
  data       Json
  createdAt  DateTime @default(now())
}

// ══════════════════════════════════════════════════════════════════════════════
//  SETTLEMENT ENGINE
//
//  Everything below is append-only accounting and settlement machinery. The
//  pre-existing models (User, Account, Transfer, Withdrawal, …) are unchanged
//  in shape: `Account.balance` remains the fast read path, but it is now a
//  *projection* of the journal rather than the source of truth. Both are
//  written in the same database transaction, and `reconciliation.service.ts`
//  proves they agree.
// ══════════════════════════════════════════════════════════════════════════════

// ── Chart of accounts ─────────────────────────────────────────────────────────
//
// Every movement of value has two sides. Before this existed, a withdrawal
// debited a user and the money simply vanished from the books — fees, FX spread,
// partner float and on-chain custody had no accounts to land in, so they were
// only ever visible as the arithmetic difference between what was debited and
// what was delivered. That is why no trial balance was possible.

model LedgerAccount {
  id        String   @id @default(cuid())

  /// Stable, human-readable identifier. Conventions:
  ///   USER:<userId>:<CCY>        customer liability (we owe the customer)
  ///   BANK:<bankId>:<CCY>        member bank liability on the AxLink network
  ///   TREASURY:<CCY>             our own funds, incl. TREASURY:USDT
  ///   CUSTODY:<vaultId>:<ASSET>  asset held in a Fireblocks vault
  ///   ONCHAIN:<mint>             asset provably on Solana
  ///   FLOAT:<providerId>:<CCY>   funds sitting at a payout partner
  ///   FEE_INCOME:<CCY>           our revenue
  ///   FX_PNL:<CCY>               realised FX gain/loss
  ///   SUSPENSE:<CCY>             known-unknown — must be zero at close of day
  code      String   @unique

  /// ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  /// Normal balance is DEBIT for ASSET/EXPENSE, CREDIT for the rest.
  type      String

  /// ISO 4217 code, or an asset symbol for crypto accounts (USDT, USDC, SOL).
  currency  String

  /// Set for USER:* and BANK:* accounts so per-party statements are a single query.
  userId    String?
  bankId    String?

  /// SUSPENSE and FX_PNL accounts are expected to be non-zero intraday but are
  /// asserted to be flat at end of day. Marked so reconciliation knows.
  transient Boolean  @default(false)

  createdAt DateTime @default(now())

  lines     JournalLine[]

  @@index([type, currency])
  @@index([userId])
  @@index([bankId])
}

// ── Journal ───────────────────────────────────────────────────────────────────
//
// Append-only. Nothing here is ever updated or deleted; a mistake is corrected
// by posting a reversing entry that references the original.

model JournalEntry {
  id           String   @id @default(cuid())

  /// Business event that caused the posting: DEPOSIT | WITHDRAWAL | P2P_TRANSFER
  /// | INTERBANK | FEE | FX | SETTLEMENT | REVERSAL | ADJUSTMENT | RECONCILIATION
  eventType    String

  /// The domain record this posting belongs to (Transfer.id, Withdrawal.id, …).
  entityType   String
  entityId     String

  /// Free-text, shown on statements.
  narrative    String

  /// Set on a reversing entry; points at the entry being reversed.
  reversesId   String?
  reverses     JournalEntry?  @relation("reversal", fields: [reversesId], references: [id])
  reversedBy   JournalEntry[] @relation("reversal")

  /// Idempotency: a second attempt to post the same logical event is rejected
  /// by this constraint rather than silently double-booking.
  postingKey   String   @unique

  postedAt     DateTime @default(now())
  postedBy     String   @default("system")

  lines        JournalLine[]

  @@index([entityType, entityId])
  @@index([eventType, postedAt])
  @@index([postedAt])
}

model JournalLine {
  id         String        @id @default(cuid())

  entryId    String
  entry      JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId  String
  account    LedgerAccount @relation(fields: [accountId], references: [id])

  /// Signed, in `currency`. Positive = debit, negative = credit.
  /// Every entry's lines sum to exactly zero per currency — asserted before write.
  amount     Decimal       @db.Decimal(28, 10)
  currency   String

  /// Value of this line in USD at posting time, for cross-currency trial balance.
  usdAmount  Decimal       @db.Decimal(28, 10)

  memo       String?

  @@index([accountId])
  @@index([entryId])
}

// ── Idempotency ───────────────────────────────────────────────────────────────
//
// A retried HTTP request must not pay twice. The unique key is enforced by the
// database, not by a read-then-write check, because two concurrent requests
// both pass a read-then-write check.

model IdempotencyKey {
  id           String   @id @default(cuid())

  /// Caller-supplied key, namespaced by scope so a bank's reference cannot
  /// collide with a user's.
  scope        String   // "withdrawal" | "p2p" | "interbank" | "deposit"
  key          String

  /// SHA-256 of the canonicalised request body. A replay with the same key but
  /// a different body is a client bug and is rejected loudly (409), not served
  /// the cached response.
  requestHash  String

  /// IN_FLIGHT | COMPLETED | FAILED
  status       String   @default("IN_FLIGHT")

  /// Response replayed to a duplicate request once COMPLETED.
  responseBody Json?
  entityType   String?
  entityId     String?

  /// Set when status = FAILED, so a retry after a genuine failure is allowed.
  failureCode  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

// ── Settlement legs ───────────────────────────────────────────────────────────
//
// A settlement is a sequence of legs, each of which either happened or did not.
// Persisting them is what makes a crash between "ledger debited" and "partner
// paid" recoverable: the resume worker reads legs stuck in a non-terminal
// status and drives them forward.

model SettlementLeg {
  id            String   @id @default(cuid())

  /// Owning domain record.
  entityType    String   // Transfer | Withdrawal | InterbankTransfer | BankDeposit | SettlementBatch
  entityId      String

  /// Ordinal within the settlement, 0-based. Legs execute in sequence.
  sequence      Int

  /// LEDGER_DEBIT | CUSTODY_TRANSFER | ONCHAIN_SETTLE | CONVERT_FIAT
  /// | PARTNER_PAYOUT | LEDGER_CREDIT | COMPENSATE
  kind          String

  /// PENDING | IN_FLIGHT | AWAITING_CONFIRMATION | COMPLETED | FAILED | COMPENSATED | ABANDONED
  status        String   @default("PENDING")

  /// Deterministic key handed to the external system so a resumed leg reuses
  /// the same request rather than creating a second one.
  externalKey   String   @unique

  /// Identifier returned by the external system (Fireblocks tx id, B2BinPay
  /// payout id, partner payment id).
  externalRef   String?

  asset         String?  // USDT | USDC | KES | GBP …
  amount        Decimal? @db.Decimal(28, 10)

  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  /// Earliest time the resume worker may retry this leg.
  nextAttemptAt DateTime?
  lastError     String?

  payload       Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  @@unique([entityType, entityId, sequence])
  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
}

// ── On-chain settlement proof ─────────────────────────────────────────────────
//
// The point of not using SWIFT is that settlement is independently verifiable.
// A Fireblocks transaction id proves only that Fireblocks accepted a request.
// This table records what actually landed on Solana, confirmed against an RPC
// node at `finalized` commitment — the artefact a counterparty or an auditor
// can check without trusting us or our custodian.

model SettlementProof {
  id             String   @id @default(cuid())

  entityType     String
  entityId       String

  /// Base-58 Solana transaction signature.
  signature      String   @unique

  /// Slot the transaction was confirmed in, and its block time.
  slot           BigInt
  blockTime      DateTime?

  /// processed | confirmed | finalized. Only `finalized` is settlement.
  commitment     String

  /// SPL mint address of the settled asset (USDC/USDT on Solana).
  mint           String
  amountRaw      String   // integer string in the mint's smallest unit
  decimals       Int
  amount         Decimal  @db.Decimal(28, 10)

  fromAddress    String
  toAddress      String

  /// Lamports actually paid. Recorded because "near-zero fee" is a claim we
  /// should be able to evidence, not just assert.
  feeLamports    BigInt?

  /// Fireblocks transaction id, when the signing went through custody.
  custodyTxId    String?

  /// Set when the RPC reports an on-chain error; the transfer is then FAILED
  /// regardless of what the custodian said.
  onchainError   String?

  verifiedAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([mint, verifiedAt])
}

// ── Transactional outbox ──────────────────────────────────────────────────────
//
// Member-bank webhooks were dispatched with a floating `.then()`. A crash or a
// partner 500 lost the notification permanently — and on this network the
// webhook is how the receiving bank learns it has money. The event row is now
// written in the same transaction as the state change, and a worker delivers it.

model OutboxEvent {
  id            String    @id @default(cuid())

  /// bank.webhook | internal.event
  channel       String
  eventType     String

  /// Delivery target — resolved at write time so a later config change cannot
  /// silently redirect an already-committed event.
  targetUrl     String?
  targetSecret  String?

  payload       Json

  /// PENDING | DELIVERING | DELIVERED | FAILED | ABANDONED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(8)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  lastStatus    Int?

  entityType    String?
  entityId      String?
  /// institution.webhook rows: the endpoint this delivery belongs to — the tenant boundary for delivery history
  webhookEndpointId String?

  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
  @@index([webhookEndpointId, createdAt])
}

// ── Provider attempt log ──────────────────────────────────────────────────────
//
// Every quote and payout we asked a partner for, and what it said. This is what
// a partner's monthly statement gets reconciled against, and what the circuit
// breaker's health picture is built from.

model ProviderAttempt {
  id            String   @id @default(cuid())

  providerId    String
  /// QUOTE | PAYOUT | FUND | STATUS
  operation     String

  entityType    String?
  entityId      String?
  reference     String?

  currency      String?
  amount        Decimal? @db.Decimal(28, 10)

  /// Funding decision that produced this attempt, for audit.
  fundingMode   String?  // ATOMIC_USDT | DIRECT_FIAT | PARTNER_FX
  settlementCurrency String?

  /// SUCCESS | FAILURE | TIMEOUT | SKIPPED_CIRCUIT_OPEN
  outcome       String
  latencyMs     Int?
  httpStatus    Int?
  errorCode     String?
  errorMessage  String?

  /// Quoted fee in USD, when operation = QUOTE. Used for routing analytics.
  quotedFeeUsd  Decimal? @db.Decimal(20, 8)
  /// True when this provider won the race.
  selected      Boolean  @default(false)

  externalRef   String?

  createdAt     DateTime @default(now())

  @@index([providerId, createdAt])
  @@index([entityType, entityId])
  @@index([outcome, createdAt])
}

// ── Reconciliation ────────────────────────────────────────────────────────────

model ReconciliationRun {
  id            String   @id @default(cuid())

  /// TRIAL_BALANCE | CUSTODY | ONCHAIN | PROVIDER | FULL
  kind          String

  /// RUNNING | CLEAN | BREAKS | ERROR
  status        String   @default("RUNNING")

  asOf          DateTime
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  /// Per-currency totals, position comparisons and timings.
  summary       Json?

  breakCount    Int      @default(0)
  breaks        ReconciliationBreak[]

  @@index([kind, startedAt])
}

model ReconciliationBreak {
  id            String            @id @default(cuid())

  runId         String
  run           ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// UNBALANCED_ENTRY | PROJECTION_DRIFT | CUSTODY_MISMATCH | ONCHAIN_MISMATCH
  /// | ORPHAN_LEG | UNPROVEN_SETTLEMENT | SUSPENSE_NONZERO
  kind          String

  /// INFO | WARN | CRITICAL
  severity      String            @default("WARN")

  subject       String            // account code, entity id, address…
  currency      String?
  expected      Decimal?          @db.Decimal(28, 10)
  actual        Decimal?          @db.Decimal(28, 10)
  delta         Decimal?          @db.Decimal(28, 10)

  detail        Json?

  resolvedAt    DateTime?
  resolvedNote  String?

  createdAt     DateTime          @default(now())

  @@index([runId, severity])
  @@index([kind, resolvedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Step 1 foundation — institutions and API environments (no financial logic)
//
// An Institution is a tenant: a bank, fintech or payment institution integrating
// AxLink. Every balance, credential and transaction record will hang off one.
// `Bank` (the existing network member model) is kept and linked, not replaced.
// ─────────────────────────────────────────────────────────────────────────────

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ApiEnvironmentKind {
  SANDBOX
  PRODUCTION
}

enum ApiEnvironmentStatus {
  ACTIVE
  DISABLED
}

model Institution {
  id            String            @id @default(cuid())
  slug          String            @unique                      // "galaxy-bank-so"
  legalName     String
  country       String                                         // ISO 3166-1 alpha-2
  kind          String                                         // BANK | FINTECH | PSP | EXCHANGE | OTHER
  status        InstitutionStatus @default(PENDING)
  contactEmail  String?
  settings      Json?                                          // non-secret institution settings
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  environments  ApiEnvironment[]
  banks         Bank[]
  users         User[]
  wallets       Wallet[]
  depositInstructions DepositInstruction[]
  counterparties Counterparty[]
  settlementTransfers SettlementTransfer[]
  webhookEndpoints    WebhookEndpoint[]

  @@index([status])
}

// One per institution per environment. Sandbox and production are isolated: separate
// credentials, separate webhook endpoint, and (in later steps) separate ledgers and vaults.
model ApiEnvironment {
  id              String               @id @default(cuid())
  institutionId   String
  institution     Institution          @relation(fields: [institutionId], references: [id])
  kind            ApiEnvironmentKind
  status          ApiEnvironmentStatus @default(ACTIVE)
  webhookUrl      String?
  webhookSecretHash String?                                    // secret shown once; only a hash is kept
  ipAllowlist     String[]             @default([])
  /// Outbound policy overrides (slice 7). Null = deployment defaults (TRANSFER_DAILY_LIMIT, TRANSFER_MAX_PER_HOUR, TRANSFER_MAX_AMOUNT).
  transferDailyLimit   Decimal?        @db.Decimal(36, 18)
  transferMaxPerHour   Int?
  transferMaxAmount    Decimal?        @db.Decimal(36, 18)
  /// The wallet that receives network settlements for this institution in this environment (explicit; null = oldest ACTIVE)
  settlementWalletId   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  credentials     ApiCredential[]

  depositInstructions DepositInstruction[]
  webhookEndpoints    WebhookEndpoint[]
  wallets         Wallet[]
  counterparties  Counterparty[]
  settlementTransfers SettlementTransfer[]
  @@unique([institutionId, kind])
}

// A credential is a key with scopes. Raw key is shown once; prefix for lookup, hash for verification.
model ApiCredential {
  id              String         @id @default(cuid())
  environmentId   String
  environment     ApiEnvironment @relation(fields: [environmentId], references: [id])
  label           String
  prefix          String         @unique                      // first 20 chars of the raw key (12 for keys issued before 2026-11-06)
  keyHash         String         @unique                      // SHA-256(raw key + server pepper)
  scopes          String[]       @default([])
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())

  @@index([environmentId])
}

// ── Provider events (remediation F1) ─────────────────────────────────────────
// One row per (provider, eventId). The unique constraint is what makes a credit exactly-once:
// the row is inserted in the same transaction as the ledger posting, so a replay — sequential or
// concurrent — fails the insert and never reaches the posting.
model ProviderEvent {
  id            String   @id @default(cuid())
  provider      String   // fireblocks | b2binpay
  eventId       String   // provider's id for this exact event (tx id + status)
  kind          String?  // provider event type
  status        String   // PROCESSED | IGNORED | REJECTED
  reason        String?
  assetId       String?  // registry AssetId (USDC_SOL, USDT_SOL) when the event carried an asset
  institutionId String?
  vaultId       String?
  entityType    String?  // BankDeposit | Withdrawal | SettlementLeg
  walletId      String?  // Step 2: the Wallet the event was attributed to
  entityId      String?
  payloadHash   String   // sha256 of the raw body
  receivedAt    DateTime @default(now())

  @@unique([provider, eventId])
  @@index([entityType, entityId])
  @@index([institutionId])
}

// ── Wallets (Step 2, slice 1) ─────────────────────────────────────────────────
// An institution's custody wallet: one custody vault on one network, holding one balance per
// registry asset. The deposit address receives every supported asset on that network (USDC and
// USDT share one Solana address). Environment-bound: a sandbox wallet can never hold production
// funds, and credentials of one environment cannot see the other's wallets.
enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Wallet {
  id              String         @id @default(cuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id])
  environmentId   String
  environment     ApiEnvironment @relation(fields: [environmentId], references: [id])
  label           String
  custodyProvider String         @default("fireblocks")
  custodyVaultId  String         // provider's vault/account id
  network         String         // registry NetworkId, e.g. solana-mainnet
  depositAddress  String?        // on-network address; null until custody has issued one
  status          WalletStatus   @default(ACTIVE)
  legacyUserId    String?        @unique // backfilled link to the legacy User row that owned the vault
  legacyUser      User?          @relation(fields: [legacyUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  balances        WalletBalance[]
  depositInstructions DepositInstruction[]
  settlementTransfers SettlementTransfer[]

  @@unique([custodyProvider, custodyVaultId])
  @@unique([environmentId, label])
  @@index([institutionId])
  @@index([environmentId])
}

// Projection of the journal's CUSTODY:<vault>:<ASSET> account, kept in the same transaction as the
// posting. Never the source of truth; reconciliation compares it to the journal.
model WalletBalance {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  assetId   String   // registry AssetId
  available Decimal  @default(0) @db.Decimal(36, 18)
  pending   Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt DateTime @updatedAt

  @@unique([walletId, assetId])
}

// ── Deposit instructions (Step 2, slice 2) ───────────────────────────────────
// An institution announces an incoming stablecoin deposit to one of its wallets. The custody
// receipt must name this instruction (externalTxId = trackingId) and match its asset and exact
// amount; nothing else credits a wallet. No legacy User row is involved.
enum DepositInstructionStatus {
  PENDING   // announced, waiting for the custody receipt
  RECEIVED  // custody confirmed the receipt; wallet credited; on-chain finality not yet proven
  SETTLED   // finality proven on a Solana node (SettlementProof row)
  CANCELLED
  EXPIRED
}

model DepositInstruction {
  id              String                   @id @default(cuid())
  institutionId   String
  institution     Institution              @relation(fields: [institutionId], references: [id])
  environmentId   String
  environment     ApiEnvironment           @relation(fields: [environmentId], references: [id])
  walletId        String
  wallet          Wallet                   @relation(fields: [walletId], references: [id])
  assetId         String                   // registry AssetId
  expectedAmount  Decimal                  @db.Decimal(36, 18)
  reference       String?                  // institution's own reference, echoed in webhooks
  trackingId      String                   @unique // dep_… — what the sender puts in the custody transfer's externalTxId
  status          DepositInstructionStatus @default(PENDING)
  providerTxId    String?                  @unique // one custody transaction settles at most one instruction
  txHash          String?
  receivedAmount  Decimal?                 @db.Decimal(36, 18)
  receivedAt      DateTime?                // custody confirmation
  settledAt       DateTime?                // on-chain finality
  lastReceiptError String?                 // last rejected receipt or proof error, for the institution to see
  lastReceiptAt   DateTime?
  expiresAt       DateTime
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([institutionId, environmentId, status])
  @@index([walletId])
}

// ── Institution webhook endpoints (Step 2, slice 2) ──────────────────────────
// Secret is stored encrypted (AES-256-GCM, WEBHOOK_ENCRYPTION_KEY) because signing needs the raw
// value; it is shown to the institution once, at creation.
enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

model WebhookEndpoint {
  id               String                @id @default(cuid())
  institutionId    String
  institution      Institution           @relation(fields: [institutionId], references: [id])
  environmentId    String
  environment      ApiEnvironment        @relation(fields: [environmentId], references: [id])
  url              String
  secretCiphertext String
  events           String[]              @default(["*"])
  status           WebhookEndpointStatus @default(ACTIVE)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([institutionId, environmentId, status])
}

// ── Outbound settlement (Step 2, slice 5) ─────────────────────────────────────
// A counterparty is a receiving address an institution has registered. It becomes usable only when
// approved: automatically in SANDBOX, by an operator in PRODUCTION after the address is whitelisted
// at the custodian (Fireblocks Transaction Authorization Policy). A transfer is money leaving a
// vault; every one is journaled, reserved before submission, and SETTLED only on Solana finality.
enum CounterpartyStatus {
  PENDING_APPROVAL
  ACTIVE
  DISABLED
}

model Counterparty {
  id             String             @id @default(cuid())
  institutionId  String
  institution    Institution        @relation(fields: [institutionId], references: [id])
  environmentId  String
  environment    ApiEnvironment     @relation(fields: [environmentId], references: [id])
  label          String
  network        String             // registry NetworkId
  /// EXTERNAL: an address outside AxLink custody (whitelisted at the custodian). NETWORK: another
  /// AxLink institution; the destination is that participant's settlement wallet in the same
  /// environment, resolved at settlement time, and the move stays inside custody.
  kind           String             @default("EXTERNAL")
  address        String             // EXTERNAL: the chain address; NETWORK: "network:<participant slug>"
  participantInstitutionId String?
  status         CounterpartyStatus @default(PENDING_APPROVAL)
  approvedBy     String?            // operator id/label, or "sandbox-auto"
  approvedAt     DateTime?
  custodyWhitelisted Boolean        @default(false) // operator attests the address is whitelisted at the custodian
  screening      Json?              // last screening result for an EXTERNAL address: { provider, verdict, risk, reasons, at }
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  transfers      SettlementTransfer[]

  @@unique([environmentId, address])
  @@index([institutionId, environmentId, status])
}

enum SettlementTransferStatus {
  AWAITING_APPROVAL // policy requires an operator decision before anything leaves the vault
  APPROVED          // journaled and reserved; custody submission pending
  SUBMITTING        // claimed by one sweeper (lease in nextAttemptAt) while the custodian is being called
  SUBMITTED         // custody accepted the transaction (providerTxId)
  CONFIRMED         // custody reports completion; txHash known; finality not yet proven
  UNDER_REVIEW      // custody and the chain (or our records) disagree after broadcast; an operator decides with evidence
  SETTLED           // Solana node reports the signature finalized (SettlementProof row)
  FAILED            // custody rejected/failed or on-chain failure — journal reversed
  REJECTED          // operator declined, or policy refused after creation
  CANCELLED         // institution cancelled while AWAITING_APPROVAL
}

model SettlementTransfer {
  id              String         @id @default(cuid())
  institutionId   String
  institution     Institution    @relation(fields: [institutionId], references: [id])
  environmentId   String
  environment     ApiEnvironment @relation(fields: [environmentId], references: [id])
  walletId        String
  wallet          Wallet         @relation(fields: [walletId], references: [id])
  counterpartyId  String
  counterparty    Counterparty   @relation(fields: [counterpartyId], references: [id])
  assetId         String
  amount          Decimal        @db.Decimal(36, 18)
  reference       String?
  idempotencyKey  String         // the institution's Idempotency-Key, unique per environment
  status          SettlementTransferStatus @default(AWAITING_APPROVAL)
  policy          Json?          // the checks that ran and their outcome, for the audit trail
  approvedBy      String?
  approvedAt      DateTime?
  journalEntryId  String?        // the CUSTODY−/INSTITUTION+ posting; reversed on failure
  /// NETWORK settlements: the receiving participant's wallet, fixed at approval, and the credit posting at SETTLED
  receivingWalletId String?
  creditEntryId   String?
  /// ON_CHAIN_FINALIZED | SANDBOX_SIMULATED | OPERATOR_ATTESTED — how SETTLED was established
  finality        String?
  providerTxId    String?        @unique
  txHash          String?
  submittedAt     DateTime?
  confirmedAt     DateTime?
  settledAt       DateTime?
  failureReason   String?
  attempts        Int            @default(0)
  nextAttemptAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([environmentId, idempotencyKey])
  @@index([institutionId, environmentId, status])
  @@index([status, nextAttemptAt])
  @@index([walletId, assetId, status])
}

// ── Operator exception queue (Step 2, slice 6b) ───────────────────────────────
// One open item per (kind, subject, currency): reconciliation re-runs bump `occurrences` and
// `lastSeenAt` instead of piling up rows; a transfer that needs a person raises one directly.
// Resolution is recorded with who and why; the item re-opens if the break recurs.
enum ExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model OperationalException {
  id            String          @id @default(cuid())
  kind          String          // CUSTODY_MISMATCH | NEGATIVE_CUSTODY | PROJECTION_DRIFT | UNPROVEN_SETTLEMENT | TRANSFER_ATTENTION | …
  severity      String          // INFO | WARN | CRITICAL
  subject       String          // account code, entity id, address…
  currency      String?
  expected      Decimal?        @db.Decimal(28, 10)
  actual        Decimal?        @db.Decimal(28, 10)
  detail        Json?
  institutionId String?
  entityType    String?
  entityId      String?
  status        ExceptionStatus @default(OPEN)
  occurrences   Int             @default(1)
  firstSeenAt   DateTime        @default(now())
  lastSeenAt    DateTime        @default(now())
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy    String?
  resolvedAt    DateTime?
  resolution    String?
  lastRunId     String?

  // Uniqueness of OPEN items is a partial index in the migration (Prisma cannot express it): one open item per (kind, subject, currency)
  @@index([kind, subject, currency, status])
  @@index([status, severity, lastSeenAt])
  @@index([institutionId, status])
}
